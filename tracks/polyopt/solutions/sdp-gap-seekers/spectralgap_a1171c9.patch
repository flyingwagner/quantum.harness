+function _gap_solver_audit(model, cons, pos, gpos, λ)
+    optimizer = unsafe_backend(model)
+    task = optimizer.task
+    fields = (
+        :primal_objective,
+        :primal_constraint_violation,
+        :primal_variable_violation,
+        :primal_psd_violation,
+        :primal_cone_violation,
+        :primal_integrality_violation,
+        :dual_objective,
+        :dual_constraint_violation,
+        :dual_variable_violation,
+        :dual_psd_violation,
+        :dual_cone_violation,
+    )
+    raw_info = try
+        Mosek.getsolutioninfo(task, Mosek.MSK_SOL_ITR)
+    catch err
+        err
+    end
+    solution_info =
+        raw_info isa Exception ?
+        (available=false, error=sprint(showerror, raw_info)) :
+        merge((available=true,), NamedTuple{fields}(raw_info))
+
+    prefix = get(ENV, "GAP_STATUS_AUDIT_PREFIX", "")
+    isempty(prefix) &&
+        return (requested=false, solution_info=solution_info)
+
+    prefix = abspath(prefix)
+    mkpath(dirname(prefix))
+    model_path = prefix * ".mof.json.gz"
+    task_path = prefix * ".ptf"
+    variable_path = prefix * ".variables.tsv"
+    residual_path = prefix * ".equalities.tsv"
+    block_path = prefix * ".psd-blocks.tsv"
+
+    write_to_file(
+        model,
+        model_path;
+        generic_names=true,
+        print_compact=true,
+    )
+    Mosek.putintparam(
+        task,
+        Mosek.MSK_IPAR_PTF_WRITE_SOLUTIONS,
+        Mosek.MSK_ON,
+    )
+    Mosek.writedata(task, task_path)
+
+    variables = all_variables(model)
+    variable_values = [
+        try
+            value(variable)
+        catch
+            NaN
+        end for variable in variables
+    ]
+    open(variable_path, "w") do io
+        println(io, "ordinal\tmoi_index\tname\tvalue")
+        for (ordinal, (variable, variable_value)) in
+            enumerate(zip(variables, variable_values))
+            println(
+                io,
+                ordinal,
+                '\t',
+                index(variable).value,
+                '\t',
+                name(variable),
+                '\t',
+                repr(variable_value),
+            )
+        end
+    end
+
+    equality_values = [
+        try
+            value(expression)
+        catch
+            NaN
+        end for expression in cons
+    ]
+    open(residual_path, "w") do io
+        println(io, "ordinal\tvalue")
+        for (ordinal, equality_value) in enumerate(equality_values)
+            println(io, ordinal, '\t', repr(equality_value))
+        end
+    end
+
+    finite_variables = filter(isfinite, variable_values)
+    variable_scale =
+        isempty(finite_variables) ? NaN :
+        max(maximum(abs, finite_variables), eps(Float64))
+    finite_equalities = filter(isfinite, equality_values)
+    equality_residual_max =
+        isempty(finite_equalities) ? NaN :
+        maximum(abs, finite_equalities)
+    block_rows = NamedTuple[]
+    for (family, blocks) in (("positive", pos), ("gap", gpos))
+        for block_index in eachindex(blocks)
+            isassigned(blocks, block_index) || continue
+            matrix = try
+                Matrix(value.(blocks[block_index]))
+            catch
+                Matrix{Float64}(undef, 0, 0)
+            end
+            isempty(matrix) && continue
+            push!(
+                block_rows,
+                (
+                    family=family,
+                    block=block_index,
+                    dimension=size(matrix, 1),
+                    min_eigenvalue=eigmin(Symmetric(matrix)),
+                    max_abs=maximum(abs, matrix),
+                ),
+            )
+        end
+    end
+    open(block_path, "w") do io
+        println(io, "family\tblock\tdimension\tmin_eigenvalue\tmax_abs")
+        for row in block_rows
+            println(
+                io,
+                row.family,
+                '\t',
+                row.block,
+                '\t',
+                row.dimension,
+                '\t',
+                repr(row.min_eigenvalue),
+                '\t',
+                repr(row.max_abs),
+            )
+        end
+    end
+    min_psd_eigenvalue =
+        isempty(block_rows) ? NaN :
+        minimum(row.min_eigenvalue for row in block_rows)
+    lambda_value = try
+        value(λ)
+    catch
+        NaN
+    end
+    return (
+        requested=true,
+        solution_info=solution_info,
+        variable_count=length(variables),
+        equality_count=length(cons),
+        variable_scale=variable_scale,
+        equality_residual_max=equality_residual_max,
+        equality_residual_relative=equality_residual_max / variable_scale,
+        min_psd_eigenvalue=min_psd_eigenvalue,
+        min_psd_eigenvalue_relative=min_psd_eigenvalue / variable_scale,
+        lambda_value=lambda_value,
+        model_path=model_path,
+        task_path=task_path,
+        variable_path=variable_path,
+        residual_path=residual_path,
+        block_path=block_path,
+    )
+end
